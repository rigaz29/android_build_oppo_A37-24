<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest OPPO A37 untuk LineageOS 24.0 (Android 17).
  Turunan dari A37-23.xml, disesuaikan terhadap manifest lineage-24.0 yang sudah
  diperiksa (default.xml + snippets/lineage.xml).

  Empat perbedaan dari versi 23.2, semuanya berdasar pemeriksaan langsung:

  1. prebuilts/gcc 4.9 DIKEMBALIKAN. Commit LineageOS de40b978 "manifest: Drop
     GCC prebuilts" membuangnya dari manifest 24.0, dan bersamaan dengan itu
     vendor/lineage/config/BoardConfigKernel.mk kehilangan SELURUH jalur GCC.
     Kernel A37 3.10.108 hanya bisa dikompilasi GCC 4.9; clang mati di
     scripts/mod/devicetable-offsets.c. Reponya masih ada, branch lineage-19.1.
     Dipasangkan dengan KERNEL_CC/KERNEL_CROSS_COMPILE di BoardConfig.mk;
     lihat PLAN-LOS24.md bagian 4.1.

  2. Daftar <linkfile> qcom-caf/common BERUBAH LAGI di 24.0: entri msm8998 dan
     sdm845 dibuang, msm8996 (yang di 23.2 sudah dikomentari) hilang seluruhnya.
     13 linkfile menjadi 11. Daftar di bawah disalin apa adanya dari
     snippets/lineage.xml 24.0. JANGAN pakai daftar 23.2 — remove-project +
     tambah-ulang menghapus seluruh linkfile milik entri resmi, jadi selisih apa
     pun berarti symlink hilang.

  3. hardware/sony/timekeep DIBUANG dari manifest 24.0 (di 23.2 masih ada).
     Karena kita memang sudah menambahkannya sendiri, yang berubah hanya
     revision -> lineage-24.0 (branch itu ada; diperiksa).

  4. Fork ULH masih menunjuk lineage-23.2 karena branch 24.0 BELUM ADA
     (diperiksa branch demi branch pada 7 September 2026: ULH dan acroreiser
     keduanya mentok di lineage-23.2). Beban forward-portnya 19 commit dan
     sudah didaftar di PLAN-LOS24.md bagian 6.1. Begitu selesai, pindahkan ke
     branch sendiri; jangan menunggu ULH.

  Cara memeriksa ulang kalau LineageOS mengubahnya lagi:
    awk '/qcom-caf_common/{p=1} p{print} p&&/<\/project>/{exit}' \
        .repo/manifests/snippets/lineage.xml
-->
<manifest>

  <remote name="gh"  fetch="https://github.com/" />
  <remote name="ulh" fetch="https://github.com/Ultra-Legacy-Hippeastrum/" />

  <!-- ============================================================
       Perangkat: device tree, kernel, blob
       Cabangkan ketiganya ke lineage-24 dari lineage-23 SEBELUM perubahan
       pertama, supaya ROM 23.2 yang stabil tidak pernah ikut tersentuh.
       ============================================================ -->

  <project name="rigaz29/rb_device_oppo_A37" path="device/oppo/A37"
           remote="gh" revision="lineage-24" />

  <project name="rigaz29/kernel_oppo_msm8939" path="kernel/oppo/msm8939"
           remote="gh" revision="lineage-24" />

  <project name="rigaz29/rb-vendor_oppo_A37" path="vendor/oppo"
           remote="gh" revision="lineage-24" />

  <!-- ============================================================
       Toolchain kernel GCC 4.9 — WAJIB di 24.0.
       Lihat catatan (1) di kepala berkas ini.
       ============================================================ -->

  <project name="LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9"
           path="prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9"
           remote="gh" revision="lineage-19.1" clone-depth="1" groups="pdk" />

  <!-- Varian arm 32-bit: hanya diperlukan kalau nanti dipakai
       CROSS_COMPILE_ARM32 / CROSS_COMPILE_COMPAT. Kernel A37 arm64 murni
       dengan vDSO32 mati, jadi dibiarkan dikomentari sampai terbukti perlu.
  <project name="LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9"
           path="prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9"
           remote="gh" revision="lineage-19.1" clone-depth="1" groups="pdk" />
  -->

  <!-- ============================================================
       Fork ULH untuk perangkat legacy.
       Masih lineage-23.2 — lihat catatan (4).
       ============================================================ -->




  <!-- system/sepolicy SENGAJA memakai hulu lineage-24.0, BUKAN fork ULH.
       Dua alasan, keduanya terbukti:

       1. Isinya tidak dibutuhkan. Fork ULH hanya satu commit di atas hulu,
          83b174ea "sepolicy: allow su domain in user builds" — dan A37
          dibangun userdebug (RILIS.md 23.2 mencatat varian user tidak bisa
          boot karena sepolicy belum lengkap untuk enforcing).

       2. Memakainya MEMATAHKAN BUILD. Plugin Go soong di fork 23.2 tidak
          kompatibel dengan API blueprint 24.0; soong bootstrap gagal 48 detik
          setelah mulai:
            bug_map.go:66     android.Cat kini blueprint.HostTool, tidak lagi
                              memenuhi blueprint.Rule (missing method String)
            cil_compat_map.go:85, flags.go:53,103
                              gobtools.CustomEnc kini menuntut method Encode
  -->

  <!-- vendor/lineage: fork sendiri untuk satu baris allowlist.

       com.android.ranging dan vendor_tracing_descriptors dirujuk base product
       AOSP tapi sumbernya BELUM ADA di pohon 24.0 — hulu menandainya sendiri di
       external/perfetto Android.bp:22225 ("TODO(primiano): /vendor").

       Harus di sini, bukan di device tree: kuncinya
       PRODUCTS.<mk-produk-teratas>.<VAR> dan variabelnya .KATI_READONLY
       (product.mk:571-572), jadi hanya boleh ada SATU panggilan
       enforce-product-packages-exist-internal per produk, dan
       common.mk:133 sudah memakainya.

       TARGET_DISABLE_EPPE := true sengaja tidak dipakai — knob itu mematikan
       seluruh pemeriksaan, padahal pemeriksaan tersebut sudah menangkap
       memtrack HIDL, libbt-vendor, dan lights HIDL yang hilang di Android 17.
  -->
  <!-- build/soong: fork sendiri untuk satu perbaikan fsgen.

       Perangkat non-Treble tidak punya partisi vendor (TARGET_COPY_OUT_VENDOR
       = system/vendor), sehingga PartitionTag() melaporkan "system" untuk modul
       bervarian vendor. Modul begitu hanya membangun varian vendor, jadi
       memasukkannya ke dependensi system image meminta varian platform yang
       tidak bisa ada:

         dependency "libstdc++_vendor" of "lineage_A37_generated_system_image"
           missing variant: os:android,arch:arm_armv8-a_cortex-a53
         available variants:
           os:android,image:vendor,arch:arm_armv8-a_cortex-a53,link:shared

       Sama untuk android.hardware.health@2.1-impl, dan akan berlaku untuk
       SETIAP modul vendor-only di PRODUCT_PACKAGES.

       Penyaring systemPartitionFalsePositive di fsgen_mutators.go memang untuk
       kelas masalah ini, tapi daftarnya hanya ramdisk, vendor_ramdisk, dan
       recovery. Penyaring itu BARU di 24.0 — di 23.2 pemeriksaannya cuma
       Enabled && ExportedToMake, itulah sebabnya A37 tidak pernah tersandung.

       Patch menambahkan varian vendor ke daftar lewati, HANYA bila vendor
       bukan partisi sendiri. Uji VendorPath() != "vendor" disalin dari
       filesystem_creator.go:228 dan :1497, jadi perangkat Treble tidak
       tersentuh.
  -->
  <!-- vendor/qcom/opensource/power DICABUT.

       A37 tidak memakainya: device.mk:911-918 eksplisit tetap memakai HIDL
       android.hardware.power@1.0-impl, bukan AIDL power-service-qti. Project
       ini hanya ikut ter-sync karena grup "qcom", lalu tetap dianalisis soong
       karena analisis mencakup seluruh pohon.

       Dan analisisnya GAGAL, sebagai akibat langsung temuan Fase 1
       (QCOM_HARDWARE_VARIANT kini terisi msm8916, di 23.2 kosong):

         BoardConfigQcom.mk:438  soong_config_set qtidisplay,headers_namespace,
                                 $(QCOM_SOONG_NAMESPACE)/display
                                 -> hardware/qcom-caf/msm8916/display
         power/Android.bp:60,78  //<headers_namespace>:display_intf_headers
                                 //<headers_namespace>:vendor.qti.hardware.display.config-V12-ndk

       Fork msm8916/display kita (lineage-22) tidak menyediakan keduanya.
       Diperiksa: nol pemakai lain qti_powerhal_headers maupun
       power-service-qti di seluruh device/, hardware/qcom-caf/, dan vendor/qcom/.
  -->
  <!-- ============================================================
       HAL QCOM khusus msm8916, fork sendiri.
       ============================================================ -->

  <!-- ============================================================
       MODEL TAMBALAN: patch, bukan fork.
       ============================================================

       Sampai 10 September 2026 manifes ini mengganti 23 repo hulu dengan fork
       rigaz29 yang sudah ditambal. Sejak itu polanya dibalik: repo tetap milik
       hulu, dan seluruh perubahan hidup sebagai patch di patches/ repo kit ini.

       Yang MASIH berupa repo di bawah hanya yang memang bukan tambalan atas
       hulu 24.0: device tree, kernel dan vendor blob milik sendiri, tiga HAL
       QCOM msm8916 yang diambil dari cabang LineageOS lain (lineage-22/23),
       serta dua repo hulu yang cuma perlu dipindahkan revisinya.

       KONSEKUENSI: sesudah `repo sync`, tambalan HARUS diterapkan ulang dengan

         tools/apply-patches.sh <pohon>

       dan `repo sync` dengan opsi force-sync membuangnya TANPA bertanya.
  -->

<!-- vendor/qcom/opensource/power DICABUT.

       A37 tidak memakainya: device.mk:911-918 eksplisit tetap memakai HIDL
       android.hardware.power@1.0-impl, bukan AIDL power-service-qti. Project
       ini hanya ikut ter-sync karena grup "qcom", lalu tetap dianalisis soong
       karena analisis mencakup seluruh pohon.

       Dan analisisnya GAGAL, sebagai akibat langsung temuan Fase 1
       (QCOM_HARDWARE_VARIANT kini terisi msm8916, di 23.2 kosong):

         BoardConfigQcom.mk:438  soong_config_set qtidisplay,headers_namespace,
                                 $(QCOM_SOONG_NAMESPACE)/display
                                 -> hardware/qcom-caf/msm8916/display
         power/Android.bp:60,78  //<headers_namespace>:display_intf_headers
                                 //<headers_namespace>:vendor.qti.hardware.display.config-V12-ndk

       Fork msm8916/display kita (lineage-22) tidak menyediakan keduanya.
       Diperiksa: nol pemakai lain qti_powerhal_headers maupun
       power-service-qti di seluruh device/, hardware/qcom-caf/, dan vendor/qcom/.
  -->
  <remove-project name="LineageOS/android_vendor_qcom_opensource_power" />

  <project name="rigaz29/android_hardware_qcom_audio" path="hardware/qcom-caf/msm8916/audio"
           remote="gh" revision="lineage-23" />
  <project name="rigaz29/android_hardware_qcom_display" path="hardware/qcom-caf/msm8916/display"
           remote="gh" revision="lineage-22" />
  <project name="rigaz29/android_hardware_qcom_media" path="hardware/qcom-caf/msm8916/media"
           remote="gh" revision="lineage-22" />

  <!-- Dipakai device.mk (PRODUCT_PACKAGES += timekeep).
       Dibuang dari manifest 24.0; branch lineage-24.0 ada di repo. -->
  <project name="LineageOS/android_hardware_sony_timekeep" path="hardware/sony/timekeep"
           remote="gh" revision="lineage-24.0" />

</manifest>
