diff --git a/core/java/com/android/internal/security/VerityUtils.java b/core/java/com/android/internal/security/VerityUtils.java
index ac186d0a26b5..7a78cb612761 100644
--- a/core/java/com/android/internal/security/VerityUtils.java
+++ b/core/java/com/android/internal/security/VerityUtils.java
@@ -56,25 +56,17 @@ public abstract class VerityUtils {
     private static final int HASH_SIZE_BYTES = 32;
 
     public static boolean isFsVeritySupported() {
-        return Build.VERSION.DEVICE_INITIAL_SDK_INT >= Build.VERSION_CODES.R;
+        return false;
     }
 
     /** Enables fs-verity for the file without signature. */
     public static void setUpFsverity(@NonNull String filePath) throws IOException {
-        int errno = enableFsverityNative(filePath);
-        if (errno != 0) {
-            throw new IOException("Failed to enable fs-verity on " + filePath + ": "
-                    + Os.strerror(errno));
-        }
+        return;
     }
 
     /** Enables fs-verity for an open file without signature. */
     public static void setUpFsverity(int fd) throws IOException {
-        int errno = enableFsverityForFdNative(fd);
-        if (errno != 0) {
-            throw new IOException("Failed to enable fs-verity on FD(" + fd + "): "
-                    + Os.strerror(errno));
-        }
+        return;
     }
 
     /** Returns whether the file has fs-verity enabled. */
diff --git a/services/core/java/com/android/server/power/hint/HintManagerService.java b/services/core/java/com/android/server/power/hint/HintManagerService.java
index 5d9e51289a1d..662559c0f006 100644
--- a/services/core/java/com/android/server/power/hint/HintManagerService.java
+++ b/services/core/java/com/android/server/power/hint/HintManagerService.java
@@ -328,9 +328,26 @@ public final class HintManagerService extends SystemService {
             try {
                 mSupportInfo = getSupportInfo();
             } catch (RemoteException e) {
-                throw new IllegalStateException("Could not contact PowerHAL!", e);
-            }
-        }
+                 Slog.w(TAG, "Could not contact Power HAL, disabling hint support", e);
+    }
+}
+
+/*
+ * Legacy devices may not provide the modern AIDL Power HAL.
+ * Keep HintManagerService alive with all optional features disabled.
+ */
+if (mSupportInfo == null) {
+    Slog.w(TAG, "Power HAL support information unavailable; using legacy fallback");
+    mSupportInfo = new SupportInfo();
+}
+
+if (mSupportInfo.headroom == null) {
+    mSupportInfo.headroom = new SupportInfo.HeadroomSupportInfo();
+}
+
+mSupportInfo.headroom.isCpuSupported = false;
+mSupportInfo.headroom.isGpuSupported = false;
+
         if (mSupportInfo.headroom.isCpuSupported) {
             mCpuHeadroomCache = new HeadroomCache<>(2, mSupportInfo.headroom.cpuMinIntervalMillis);
             mUidToLastUserModeJiffies = new ArrayMap<>();
diff --git a/services/core/java/com/android/server/power/stats/BluetoothPowerStatsCollector.java b/services/core/java/com/android/server/power/stats/BluetoothPowerStatsCollector.java
index 64c831ccc770..cb99a81fec56 100644
--- a/services/core/java/com/android/server/power/stats/BluetoothPowerStatsCollector.java
+++ b/services/core/java/com/android/server/power/stats/BluetoothPowerStatsCollector.java
@@ -84,6 +84,27 @@ public class BluetoothPowerStatsCollector extends PowerStatsCollector {
     private long mLastTxTime;
     private long mLastIdleTime;
 
+    /**
+     * A37: berapa kali kegagalan pengambilan BluetoothActivityEnergyInfo masih
+     * dicatat LENGKAP dengan stack trace.
+     *
+     * Controller Bluetooth perangkat ini tidak mendukung pelaporan energi
+     * aktivitas, jadi requestControllerActivityEnergyInfo() SELALU memanggil
+     * onBluetoothActivityEnergyInfoError(). Kegagalannya permanen, bukan
+     * sementara.
+     *
+     * Yang mahal bukan kegagalannya melainkan pencatatannya: tiap siklus
+     * pengumpulan statistik daya membangun RuntimeException, menelusuri stack,
+     * memformatnya, lalu menulis ~25 baris. Terukur di perangkat: 23 kegagalan
+     * menghasilkan 575 baris log.
+     *
+     * Tiga yang pertama tetap lengkap supaya nilai diagnostiknya utuh;
+     * sesudahnya pesannya tetap dicatat (murah) tapi tanpa stack trace. Ini
+     * pola yang sama dengan mDisabledServiceTraceLogged di RIL.java.
+     */
+    private static final int MAX_ACTIVITY_INFO_FAILURE_TRACES = 3;
+    private int mActivityInfoFailures;
+
     private static class UidStats {
         public long rxCount;
         public long lastRxCount;
@@ -200,7 +221,17 @@ public class BluetoothPowerStatsCollector extends PowerStatsCollector {
             activityInfo = immediateFuture.get(BLUETOOTH_ACTIVITY_REQUEST_TIMEOUT,
                     TimeUnit.MILLISECONDS);
         } catch (Exception e) {
-            Slog.e(TAG, "Cannot acquire BluetoothActivityEnergyInfo", e);
+            // A37: batasi stack trace, lihat MAX_ACTIVITY_INFO_FAILURE_TRACES.
+            if (mActivityInfoFailures < MAX_ACTIVITY_INFO_FAILURE_TRACES) {
+                mActivityInfoFailures++;
+                Slog.e(TAG, "Cannot acquire BluetoothActivityEnergyInfo", e);
+                if (mActivityInfoFailures == MAX_ACTIVITY_INFO_FAILURE_TRACES) {
+                    Slog.e(TAG, "Cannot acquire BluetoothActivityEnergyInfo:"
+                            + " kegagalan berikutnya dicatat tanpa stack trace");
+                }
+            } else {
+                Slog.w(TAG, "Cannot acquire BluetoothActivityEnergyInfo: " + e);
+            }
             activityInfo = null;
         }
 
