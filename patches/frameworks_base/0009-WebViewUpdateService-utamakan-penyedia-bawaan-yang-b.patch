 .../webkit/WebViewUpdateServiceImpl2.java     | 46 ++++++++++++++++++-
 1 file changed, 44 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/webkit/WebViewUpdateServiceImpl2.java b/services/core/java/com/android/server/webkit/WebViewUpdateServiceImpl2.java
index 335ad366d7b0..24661683f32c 100644
--- a/services/core/java/com/android/server/webkit/WebViewUpdateServiceImpl2.java
+++ b/services/core/java/com/android/server/webkit/WebViewUpdateServiceImpl2.java
@@ -110,13 +110,46 @@ class WebViewUpdateServiceImpl2 {
         mSystemInterface = systemInterface;
         WebViewProviderInfo[] webviewProviders = getWebViewPackages();
 
+        // [A37] Utamakan penyedia bawaan yang BENAR-BENAR TERPASANG.
+        //
+        // Semula perulangan ini mengambil penyedia availableByDefault yang
+        // pertama lalu berhenti, tanpa memeriksa apakah paketnya ada. Daftar
+        // penyedia LineageOS menempatkan com.google.android.webview di urutan
+        // pertama dan com.android.webview di urutan terakhir, sehingga pada
+        // pemasangan tanpa GApps yang terpilih adalah paket yang tidak pernah
+        // ada -- dan findPreferredWebViewPackage tidak punya jalan mundur:
+        //
+        //   W WebViewUpdateServiceImpl2: Default WebView package
+        //     (com.google.android.webview) not found
+        //   E WebViewUpdateServiceImpl2: WebViewPackageMissingException:
+        //     Could not find a loadable WebView package
+        //
+        // Akibatnya setiap aplikasi yang menyentuh WebView gagal dijalankan:
+        //
+        //   MissingWebViewPackageException: Failed to load WebView provider:
+        //     No WebView installed
+        //
+        // Urutan prioritas tetap dihormati: yang dipilih adalah penyedia
+        // TERPASANG pertama menurut urutan daftar, jadi bila Google WebView
+        // ada ia tetap menang. Bila tidak satu pun terpasang, perilakunya
+        // kembali seperti semula -- penyedia bawaan pertama -- supaya paket
+        // yang menyusul dipasang belakangan tetap dikenali.
         WebViewProviderInfo defaultProvider = null;
+        WebViewProviderInfo firstAvailableByDefault = null;
         for (WebViewProviderInfo provider : webviewProviders) {
-            if (provider.availableByDefault) {
+            if (!provider.availableByDefault) {
+                continue;
+            }
+            if (firstAvailableByDefault == null) {
+                firstAvailableByDefault = provider;
+            }
+            if (defaultProvider == null && isProviderPackageInstalled(provider)) {
                 defaultProvider = provider;
-                break;
             }
         }
+        if (defaultProvider == null) {
+            defaultProvider = firstAvailableByDefault;
+        }
         if (defaultProvider == null) {
             // This should be unreachable because the config parser enforces that there is at least
             // one availableByDefault provider.
@@ -125,6 +158,15 @@ class WebViewUpdateServiceImpl2 {
         mDefaultProvider = defaultProvider;
     }
 
+    /** [A37] Apakah paket penyedia ini ada di perangkat. */
+    private boolean isProviderPackageInstalled(WebViewProviderInfo provider) {
+        try {
+            return mSystemInterface.getPackageInfoForProvider(provider) != null;
+        } catch (NameNotFoundException e) {
+            return false;
+        }
+    }
+
     public void packageStateChanged(String packageName, int changedState, int userId) {
         // We don't early out here in different cases where we could potentially early-out (e.g. if
         // we receive PACKAGE_CHANGED for another user than the system user) since that would
