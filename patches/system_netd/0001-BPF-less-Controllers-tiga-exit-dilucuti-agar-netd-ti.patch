From 4ed42908083f562d1cacbf99d704105642f8b824 Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Tue, 8 Sep 2026 12:26:34 +0000
Subject: [PATCH] BPF-less:Controllers: tiga exit() dilucuti agar netd tidak
 crash-loop

Kernel OPPO A37 3.10.108 tidak punya eBPF sama sekali; jalur BPF di sini selalu
gagal. Yang fatal bukan kegagalannya melainkan reaksinya -- proses mati, init
menghidupkannya lagi, dan perangkat tidak pernah boot.

Diturunkan dari set los-23.2_n7000_bpfless.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Change-Id: I8c95bbd369dac0d41ef0f742d73f9f47eb77d4d7
---
 server/Controllers.cpp | 9 +++++----
 server/main.cpp        | 2 +-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/server/Controllers.cpp b/server/Controllers.cpp
index 8a2c3be3..7faf4667 100644
--- a/server/Controllers.cpp
+++ b/server/Controllers.cpp
@@ -323,25 +323,26 @@ int Controllers::initIptablesRules() {
 
 void Controllers::init() {
     if (initIptablesRules()) {
+        // [A37] netd keluar di sini berarti init menghidupkannya lagi tanpa
+        // henti. Aturan iptables gagal dipasang bukan alasan menolak boot.
         gLog.error("Failed to initialize iptables rules");
-        exit(1);
     }
     Stopwatch s;
 
     if (int ret = bandwidthCtrl.enableBandwidthControl()) {
-        gLog.error("Failed to initialize BandwidthController (%s)", strerror(-ret));
+        gLog.info("[A37] Failed to initialize BandwidthController (%s)", strerror(-ret));
         // A failure to init almost definitely means that iptables failed to load
         // our static ruleset, which then basically means network accounting will not work.
         // As such simply exit netd.  This may crash loop the system, but by failing
         // to bootup we will trigger rollback and thus this offers us protection against
         // a mainline update breaking things.
-        exit(2);
+        // [A37] exit(2) dibuang: BandwidthController butuh eBPF.
     }
     gLog.info("Enabling bandwidth control: %" PRId64 "us", s.getTimeAndResetUs());
 
     if (int ret = RouteController::Init(NetworkController::LOCAL_NET_ID)) {
         gLog.error("Failed to initialize RouteController (%s)", strerror(-ret));
-        exit(3);
+        // [A37] exit(3) dibuang bersama dua di atas.
     }
     gLog.info("Initializing RouteController: %" PRId64 "us", s.getTimeAndResetUs());
 
diff --git a/server/main.cpp b/server/main.cpp
index be9a1d03..e84899e4 100644
--- a/server/main.cpp
+++ b/server/main.cpp
@@ -147,7 +147,7 @@ int main(const int argc, const char* argv[]) {
 
     if (libnetd_updatable_init(cg2_path.c_str())) {
         ALOGE("libnetd_updatable_init failed");
-        exit(1);
+        //exit(1);
     }
     gLog.info("libnetd_updatable_init success");
 
