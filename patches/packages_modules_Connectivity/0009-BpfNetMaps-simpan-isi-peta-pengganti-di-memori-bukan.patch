     private static class NoOpBpfMap<K extends Struct, V extends Struct>
             implements IBpfMap<K, V> {
+        private final LinkedHashMap<K, V> mEntries = new LinkedHashMap<>();
+
         @Override
-        public void updateEntry(K key, V value) { }
+        public synchronized void updateEntry(K key, V value) {
+            mEntries.put(key, value);
+        }
 
         @Override
-        public void insertEntry(K key, V value) { }
+        public synchronized void insertEntry(K key, V value) throws IllegalStateException {
+            if (mEntries.containsKey(key)) {
+                throw new IllegalStateException("Entry already exists");
+            }
+            mEntries.put(key, value);
+        }
 
         @Override
-        public void replaceEntry(K key, V value) { }
+        public synchronized void replaceEntry(K key, V value) throws NoSuchElementException {
+            if (!mEntries.containsKey(key)) {
+                throw new NoSuchElementException("Entry does not exist");
+            }
+            mEntries.put(key, value);
+        }
 
         @Override
-        public boolean insertOrReplaceEntry(K key, V value) {
-            return false;
+        public synchronized boolean insertOrReplaceEntry(K key, V value) {
+            return mEntries.put(key, value) == null;
         }
 
         @Override
-        public boolean deleteEntry(K key) {
-            return false;
+        public synchronized boolean deleteEntry(K key) {
+            return mEntries.remove(key) != null;
         }
 
         @Override
-        public K getNextKey(@NonNull K key) {
+        public synchronized K getNextKey(@NonNull K key) {
+            boolean seen = false;
+            for (K candidate : mEntries.keySet()) {
+                if (seen) return candidate;
+                if (candidate.equals(key)) seen = true;
+            }
             return null;
         }
 
         @Override
-        public K getFirstKey() {
+        public synchronized K getFirstKey() {
+            for (K candidate : mEntries.keySet()) return candidate;
             return null;
         }
 
         @Override
-        public boolean containsKey(@NonNull K key) {
-            return false;
+        public synchronized boolean containsKey(@NonNull K key) {
+            return mEntries.containsKey(key);
         }
 
         @Override
-        public V getValue(@NonNull K key) {
-            return null;
+        public synchronized V getValue(@NonNull K key) {
+            return mEntries.get(key);
         }
 
         @Override
