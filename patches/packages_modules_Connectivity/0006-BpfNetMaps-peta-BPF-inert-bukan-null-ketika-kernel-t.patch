+    /**
+     * [A37] Peta BPF inert untuk kernel tanpa eBPF.
+     *
+     * Sebelumnya getter di kelas ini mengembalikan null ketika peta tidak dapat
+     * dibuka. Itu memang menghentikan lemparan di titik pembuatan, tetapi hanya
+     * memindahkan kegagalannya: setiap pemakai lalu men-dereferensi null.
+     * Kegagalan berikutnya muncul di jalur yang tidak terbungkus try/catch dan
+     * tetap menjatuhkan system_server:
+     *
+     *   NullPointerException: Attempt to invoke interface method
+     *     ...IBpfMap.getValue(...)
+     *     at BpfNetMaps.setChunkPermListForUids(BpfNetMaps.java:1629)
+     *     at PermissionMonitor.<init>(PermissionMonitor.java:488)
+     *     at ConnectivityService.<init>(ConnectivityService.java:2640)
+     *
+     * Menambal tiap pemakaian berarti memburu sebelas peta di puluhan metode,
+     * satu bootloop untuk tiap yang terlewat. Peta inert menyelesaikannya di
+     * satu tempat: seluruh pemanggil berjalan tanpa perubahan, tulis diabaikan,
+     * baca mengembalikan kosong, dan forEach/clear/isEmpty yang default di
+     * IBpfMap ikut benar dengan sendirinya karena getFirstKey mengembalikan
+     * null.
+     *
+     * Fitur yang bergantung pada eBPF -- statistik per-uid, firewall per-uid,
+     * data saver berbasis peta -- memang tidak berfungsi. Itu sudah pasti di
+     * kernel ini, dengan atau tanpa kelas ini.
+     */
+    private static class NoOpBpfMap<K extends Struct, V extends Struct>
+            implements IBpfMap<K, V> {
+        @Override
+        public void updateEntry(K key, V value) { }
+
+        @Override
+        public void insertEntry(K key, V value) { }
+
+        @Override
+        public void replaceEntry(K key, V value) { }
+
+        @Override
+        public boolean insertOrReplaceEntry(K key, V value) {
+            return false;
+        }
+
+        @Override
+        public boolean deleteEntry(K key) {
+            return false;
+        }
+
+        @Override
+        public K getNextKey(@NonNull K key) {
+            return null;
+        }
+
+        @Override
+        public K getFirstKey() {
+            return null;
+        }
+
+        @Override
+        public boolean containsKey(@NonNull K key) {
+            return false;
+        }
+
+        @Override
+        public V getValue(@NonNull K key) {
+            return null;
+        }
+
+        @Override
+        public void close() { }
+    }
 }
