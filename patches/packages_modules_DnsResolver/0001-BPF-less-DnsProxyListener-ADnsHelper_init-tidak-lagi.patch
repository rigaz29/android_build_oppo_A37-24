From 4f3822c7ca7b2337377b2513e143ef3871c98478 Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Tue, 8 Sep 2026 12:26:18 +0000
Subject: [PATCH] BPF-less:DnsProxyListener: ADnsHelper_init tidak lagi abort
 netd

Kernel OPPO A37 3.10.108 tidak punya eBPF sama sekali; jalur BPF di sini selalu
gagal. Yang fatal bukan kegagalannya melainkan reaksinya -- proses mati, init
menghidupkannya lagi, dan perangkat tidak pernah boot.

Diturunkan dari set los-23.2_n7000_bpfless.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Change-Id: I852d35c15995664bb1b0cd22ff60d32b78f20897
---
 DnsProxyListener.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/DnsProxyListener.cpp b/DnsProxyListener.cpp
index f55d2c5..1ad9b87 100644
--- a/DnsProxyListener.cpp
+++ b/DnsProxyListener.cpp
@@ -717,7 +717,10 @@ DnsProxyListener::DnsProxyListener() : FrameworkListener(SOCKET_NAME) {
     mGetDnsNetIdCommand = std::make_unique<GetDnsNetIdCommand>();
     registerCmd(mGetDnsNetIdCommand.get());
 
-    if (ADnsHelper_init()) abort();
+    // [A37] ADnsHelper_init memasang map BPF; pada kernel tanpa eBPF ia selalu
+    // gagal. abort() di sini menjatuhkan netd, dan init menghidupkannya lagi
+    // tanpa henti. Resolusi DNS sendiri tidak bergantung pada BPF.
+    if (ADnsHelper_init()) LOG(WARNING) << "[A37] ADnsHelper_init gagal, lanjut tanpa BPF";
 }
 
 void DnsProxyListener::Handler::spawn() {
